model
  schema 1.1
type stuff
type folder
  relations
    define parent: [folder with test]
    define owner: [stuff]
    define parent_owner: owner from parent or parent_owner from parent
    define viewer: [stuff] or owner or parent_owner
    define can_share: owner
    define can_write: owner or parent_owner
    define can_view: viewer or viewer from parent
    define can_do: viewer

condition test(current_timestamp: timestamp, grant_timestamp: timestamp, grant_duration: duration, user_ip: ipaddress, cidr: string) {
    (current_timestamp < grant_timestamp + grant_duration) && user_ip.in_cidr(cidr)
}
